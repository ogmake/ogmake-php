{
    "name": "ogmake/ogmake-php",
    "description": "Framework-agnostic PHP SDK for the ogmake OG image API: signed and public image URLs, stored renders, typed errors.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "homepage": "https://ogmake.com",
    "authors": [{ "name": "ogmake", "email": "support@ogmake.com", "homepage": "https://ogmake.com" }],
    "support": { "email": "support@ogmake.com", "source": "https://github.com/IgorBaranov/ogmake-php" },
    "keywords": ["ogmake", "open-graph", "og-image"],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "Ogmake\\": "src/" } },
    "autoload-dev": { "psr-4": { "Ogmake\\Tests\\": "tests/" } },
    "scripts": { "test": "phpunit" },
    "minimum-stability": "stable",
    "prefer-stable": true
}
